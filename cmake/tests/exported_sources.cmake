cmake_minimum_required(VERSION 3.20)

get_filename_component(_proton_share "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
file(READ "${_proton_share}/cmake/protonConfig.cmake.in" package_config)

file(GLOB_RECURSE core_sources "${_proton_share}/core/src/*.c")
file(GLOB nanopb_sources "${_proton_share}/external/nanopb/*.c")
list(APPEND core_sources ${nanopb_sources})
file(GLOB_RECURSE cpp_sources "${_proton_share}/cpp/src/*.cpp")
file(GLOB_RECURSE node_builder_sources "${_proton_share}/cpp/src/node_builder/*.cpp")
list(REMOVE_ITEM cpp_sources ${node_builder_sources})

function(check_exported_sources source_list expected_list)
  string(REGEX MATCH "set\\(${source_list}[ \t\r\n]+[^)]*\\)" declaration "${package_config}")
  if(NOT declaration)
    message(FATAL_ERROR "${source_list}: source list not found in protonConfig.cmake.in")
  endif()
  cmake_language(EVAL CODE "${declaration}")

  set(missing ${${expected_list}})
  list(REMOVE_ITEM missing ${${source_list}})
  set(unexpected ${${source_list}})
  list(REMOVE_ITEM unexpected ${${expected_list}})
  set(unique_sources ${${source_list}})
  list(REMOVE_DUPLICATES unique_sources)
  list(LENGTH ${source_list} source_count)
  list(LENGTH unique_sources unique_count)

  if(missing)
    message(SEND_ERROR "${source_list}: missing exports: ${missing}")
  endif()
  if(unexpected)
    message(SEND_ERROR "${source_list}: unexpected exports: ${unexpected}")
  endif()
  if(NOT source_count EQUAL unique_count)
    message(SEND_ERROR "${source_list}: duplicate exports")
  endif()
endfunction()

check_exported_sources(PROTON_CORE_SOURCES core_sources)
check_exported_sources(PROTON_CPP_SOURCES cpp_sources)
check_exported_sources(PROTON_CPP_NODE_BUILDER_SOURCES node_builder_sources)
